+// argoTask records, per Argo main container, where completion + output data
+// must land. It is populated at Create and consumed once at Delete.
+type argoTask struct {
+	// exitDir is <argoEmptyDirSource>/ctr/<name>; the "exitcode" file goes here.
+	exitDir string
+	// outputSrc is the host path of the guest's declared output block volume
+	// (empty when none was declared). After the runtime restores the block
+	// volume during Delete, this path holds the guest-written files.
+	outputSrc string
+	// outputDest is <argoEmptyDirSource>/outputs; extracted files land here,
+	// visible to the trusted wait sidecar sharing the same emptyDir.
+	outputDest string
+}

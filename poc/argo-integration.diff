 func (s *taskService) Delete(ctx context.Context, r *taskAPI.DeleteRequest) (*taskAPI.DeleteResponse, error) {
-	return s.TaskService.Delete(ctx, r)
+	// The inner Delete runs "urunc delete", which restores (remounts host-side)
+	// the guest's block volume before returning. So by the time it returns, any
+	// declared output volume is readable at at.outputSrc.
+	resp, err := s.TaskService.Delete(ctx, r)
+	if err != nil {
+		return resp, err
+	}
+
+	s.mu.Lock()
+	at, ok := s.argoTasks[r.ID]
+	if ok {
+		delete(s.argoTasks, r.ID)
+	}
+	s.mu.Unlock()
+
+	if !ok || resp == nil {
+		return resp, nil
+	}
+
+	// 1. Extract guest outputs into the shared emptyDir (best-effort). This runs
+	//    strictly before the completion file so the wait sidecar never observes
+	//    completion before the artifacts are on disk.
+	if at.outputSrc != "" {
+		if n, cerr := copyOutputs(at.outputSrc, at.outputDest); cerr != nil {
+			log.G(ctx).WithError(cerr).WithField("src", at.outputSrc).
+				Warn("urunc(shim): Argo output extraction failed (continuing to signal completion)")
+		} else if n > 0 {
+			log.G(ctx).WithField("dest", at.outputDest).WithField("files", n).
+				Info("urunc(shim): extracted Argo outputs")
+		}
+	}
+
+	// 2. Signal completion LAST.
+	if werr := writeArgoExitcode(at.exitDir, resp.ExitStatus); werr != nil {
+		log.G(ctx).WithError(werr).Warn("urunc(shim): failed to write Argo exitcode file")
+	} else {
+		log.G(ctx).WithField("dir", at.exitDir).WithField("code", resp.ExitStatus).
+			Info("urunc(shim): wrote Argo completion file")
+	}
+
+	return resp, nil
 }
 
 func (s *taskService) RegisterTTRPC(server *ttrpc.Server) error {
 	taskAPI.RegisterTaskService(server, s)
 	return nil
 }
+
+// isArgoEmissaryArgs reports whether an OCI process was rewritten by Argo's
+// emissary executor ("<path>/argoexec emissary -- <user cmd>"). Nil-safe.
+func isArgoEmissaryArgs(p *specs.Process) bool {
+	if p == nil || len(p.Args) < 2 {
+		return false
+	}
+	return filepath.Base(p.Args[0]) == "argoexec" && p.Args[1] == "emissary"
+}
+
+// parseArgoTask inspects the OCI bundle and, if it belongs to an Argo "main"
+// container, returns its completion/extraction context. Resolution of "is this
+// Argo": the sandboxProfile annotation is authoritative when present
+// ("argo-workflow" enables, any other explicit value disables); an absent
+// annotation falls back to emissary argv detection. Any parse failure or
+// non-Argo container returns (nil, false), preserving legacy behavior.
+func parseArgoTask(bundle string) (*argoTask, bool) {
+	data, err := os.ReadFile(filepath.Join(bundle, "config.json"))
+	if err != nil {
+		return nil, false
+	}
+	var spec specs.Spec
+	if err := json.Unmarshal(data, &spec); err != nil {
+		return nil, false
+	}
+	switch spec.Annotations[annotSandboxProfile] {
+	case sandboxProfileArgo:
+		// enabled explicitly
+	case "":
+		if !isArgoEmissaryArgs(spec.Process) {
+			return nil, false
+		}
+	default:
+		return nil, false
+	}
+
+	// Scope strictly to the unikernel "main" container. urunc runs only
+	// containers carrying the unikernel annotations as a VMM, exactly as
+	// cmd/urunc/create.go distinguishes them (ErrNotUnikernel) from Argo's
+	// argoexec init/wait sidecars, which are delegated to runc. The
+	// sandboxProfile annotation is pod-scoped, so without this check it would
+	// also match those sidecars and write spurious completion files for them.
+	if spec.Annotations[annotUnikernelType] == "" {
+		return nil, false
+	}
+
+	// Host path backing the /var/run/argo emptyDir shared with the wait sidecar.
+	argoSrc := ""
+	for i := range spec.Mounts {
+		if spec.Mounts[i].Destination == "/var/run/argo" {
+			argoSrc = spec.Mounts[i].Source
+			break
+		}
+	}
+	if argoSrc == "" {
+		return nil, false
+	}
+
+	name := spec.Annotations["io.kubernetes.cri.container-name"]
+	if name == "" {
+		name = "main"
+	}
+
+	at := &argoTask{
+		exitDir:    filepath.Join(argoSrc, "ctr", name),
+		outputDest: filepath.Join(argoSrc, "outputs"),
+	}
+
+	// Optional: a declared output block volume. The annotation names the guest
+	// mount destination; its backing host Source (readable after the runtime
+	// restores the block volume during Delete) is what we extract.
+	if dst := spec.Annotations[annotArgoOutputVol]; dst != "" {
+		for i := range spec.Mounts {
+			if spec.Mounts[i].Destination == dst {
+				at.outputSrc = spec.Mounts[i].Source
+				break
+			}
+		}
+	}
+	return at, true
+}
+
+// writeArgoExitcode writes Argo's completion file: <dir>/exitcode containing the
+// guest's exit status as a decimal string, matching what argoexec's emissary
+// executor would have written. The wait sidecar's inotify watch then observes
+// completion and the workflow node finishes.
+func writeArgoExitcode(dir string, code uint32) error {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("mkdir %s: %w", dir, err)
+	}
+	path := filepath.Join(dir, "exitcode")
+	if err := os.WriteFile(path, []byte(strconv.Itoa(int(code))), 0o644); err != nil {
+		return fmt.Errorf("write %s: %w", path, err)
+	}
+	return nil
+}
+
+// copyOutputs recursively copies regular files from srcDir into destDir,
+// preserving the relative directory structure. It returns the number of files
+// copied. Security guards for untrusted, guest-authored content:
+//   - symlinks (and any non-regular file) are skipped, never followed, so the
+//     copy cannot escape srcDir or destDir via a crafted link;
+//   - a path that would resolve outside destDir is rejected;
+//   - the total number of bytes copied is capped at maxExtractBytes.
+//
+// A missing srcDir is not an error (returns 0): a guest may declare an output
+// volume but write nothing.
+func copyOutputs(srcDir, destDir string) (int, error) {
+	info, err := os.Stat(srcDir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return 0, nil
+		}
+		return 0, err
+	}
+	if !info.IsDir() {
+		return 0, fmt.Errorf("output source %s is not a directory", srcDir)
+	}
+
+	var copied int
+	var total int64
+	walkErr := filepath.WalkDir(srcDir, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		// Skip symlinks and any non-regular, non-dir entry: never follow them.
+		if d.Type()&fs.ModeSymlink != 0 {
+			return nil
+		}
+		rel, err := filepath.Rel(srcDir, path)
+		if err != nil {
+			return err
+		}
+		if rel == "." {
+			return nil
+		}
+		// Defense in depth: reject any relative path that escapes destDir.
+		if rel == ".." || strings.HasPrefix(rel, ".."+string(os.PathSeparator)) {
+			return fmt.Errorf("refusing path escaping output dir: %s", rel)
+		}
+		target := filepath.Join(destDir, rel)
+
+		if d.IsDir() {
+			return os.MkdirAll(target, 0o755)
+		}
+		if !d.Type().IsRegular() {
+			return nil
+		}
+		fi, err := d.Info()
+		if err != nil {
+			return err
+		}
+		if total+fi.Size() > maxExtractBytes {
+			return fmt.Errorf("output extraction exceeds %d byte cap", int64(maxExtractBytes))
+		}
+		n, err := copyFile(path, target)
+		if err != nil {
+			return err
+		}
+		total += n
+		copied++
+		return nil
+	})
+	if walkErr != nil {
+		return copied, walkErr
+	}
+	return copied, nil
+}
+
+// copyFile copies a single regular file, creating parent dirs. Returns bytes written.
+func copyFile(src, dst string) (int64, error) {
+	if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
+		return 0, err
+	}
+	in, err := os.Open(src)
+	if err != nil {
+		return 0, err
+	}
+	defer in.Close()
+	out, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o644)
+	if err != nil {
+		return 0, err
+	}
+	n, err := io.Copy(out, in)
+	if cerr := out.Close(); err == nil {
+		err = cerr
+	}
+	return n, err
+}

 	return state == "running"
 }
 
-// getNetworkType checks if current container is a knative user-container
+// getNetworkType selects the network model for the guest. Knative
+// user-containers and Argo emissary "main" containers use "static" mode, which
+// skips the catch-all tc-redirect filter (addTCRules=false) that would
+// otherwise steal all inbound traffic on the shared pod netns and blind
+// co-located sidecars (e.g. Argo's wait sidecar). Every other container keeps
+// the default "dynamic" mode, unchanged.
 func (u Unikontainer) getNetworkType() string {
 	if u.Spec.Annotations["io.kubernetes.cri.container-name"] == "user-container" {
 		return "static"
 	}
+	if argoWorkflowContext(u.Spec) {
+		return "static"
+	}
 	return "dynamic"
 }
+
+// argoWorkflowContext reports whether this container should engage urunc's Argo
+// Workflows integration (static network mode + shim-side completion file).
+// Resolution order (Milestone 1 annotation profile):
+//  1. The com.urunc.unikernel.sandboxProfile annotation, when present, is
+//     authoritative: "argo-workflow" enables it; any other value (including
+//     "none" and "knative") disables it.
+//  2. When the annotation is absent, fall back to argv auto-detection so that
+//     annotation-less clusters keep the baseline behavior unchanged.
+func argoWorkflowContext(spec *specs.Spec) bool {
+	if spec == nil {
+		return false
+	}
+	switch spec.Annotations[annotSandboxProfile] {
+	case sandboxProfileArgo:
+		return true
+	case "":
+		return isArgoEmissaryMain(spec)
+	default:
+		return false
+	}
+}
+
+// isArgoEmissaryMain reports whether spec is an Argo Workflows "main" container
+// wrapped by the emissary executor. Argo rewrites the main container's command
+// to "<path>/argoexec emissary -- <user command>", so detection is a pure argv
+// check that needs no extra configuration. Returns false (legacy behavior) for
+// any spec that is nil, has no process, or does not match.
+func isArgoEmissaryMain(spec *specs.Spec) bool {
+	if spec == nil || spec.Process == nil {
+		return false
+	}
+	args := spec.Process.Args
+	if len(args) < 2 {
+		return false
+	}
+	return filepath.Base(args[0]) == "argoexec" && args[1] == "emissary"
+}

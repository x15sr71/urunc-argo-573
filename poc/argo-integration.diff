+	argoTasks map[string]*argoTask
 }
 
 func (s *taskService) Create(ctx context.Context, r *taskAPI.CreateTaskRequest) (*taskAPI.CreateTaskResponse, error) {
@@ -52,27 +94,263 @@ func (s *taskService) Create(ctx context.Context, r *taskAPI.CreateTaskRequest)
